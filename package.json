{
  "name": "gate",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gate/api --filter @gate/web dev",
    "start": "pnpm --filter @gate/api start",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.tools.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @gate/api migrate",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "pg": "^8.16.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.35.0",
    "@eslint/js": "^9.35.0",
    "typescript-eslint": "^8.43.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "^26.1.0"
  }
}
